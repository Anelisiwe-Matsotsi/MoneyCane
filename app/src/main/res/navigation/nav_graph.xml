<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/AuthenticationFragment"
        android:name="com.example.prog7313_sem1_part2.AuthenticationFragment"
        android:label="AuthenticationFragment"
        tools:layout="@layout/prompt_security">

        <action
            android:id="@+id/action_AuthenticationFragment_to_home"
            app:destination="@id/home" />
        <action
            android:id="@+id/action_AuthenticationFragment_to_logFragment"
            app:destination="@id/logFragment" />
        <action
            android:id="@+id/action_AuthenticationFragment_to_CreatePinFragment"
            app:destination="@id/CreatePinFragment" />
    </fragment>

    <fragment
        android:id="@+id/AppSecurityFragment"
        android:name="com.example.prog7313_sem1_part2.AppSecurityFragment"
        android:label="AppSecurityFragment"
        tools:layout="@layout/app_security">

        <action
            android:id="@+id/action_AppSecurityFragment_to_CreatePinFragment"
            app:destination="@id/CreatePinFragment" />
    </fragment>

    <fragment
        android:id="@+id/CreatePinFragment"
        android:name="com.example.prog7313_sem1_part2.CreatePinFragment"
        android:label="CreatePinFragment"
        tools:layout="@layout/create_pin">

        <action
            android:id="@+id/action_CreatePinFragment_to_home"
            app:destination="@id/home"/>
    </fragment>

    <fragment
        android:id="@+id/logFragment"
        android:name="com.example.prog7313_sem1_part2.LogFragment"
        android:label="LogFragment"
        tools:layout="@layout/fragment_log">

        <action
            android:id="@+id/action_logFragment_to_CreatePinFragment"
            app:destination="@id/CreatePinFragment" />
        <action
            android:id="@+id/action_logFragment_to_home"
            app:destination="@id/home" />
        <action
            android:id="@+id/action_logFragment_to_registerFragmentLight"
            app:destination="@id/registerFragmentLight" />
    </fragment>
    <fragment
        android:id="@+id/budgetLight"
        android:name="com.example.prog7313_sem1_part2.BudgetLight"
        android:label="fragment_budget_light"
        tools:layout="@layout/fragment_budget_light" >
        <action
            android:id="@+id/action_budgetLight_to_analysisLight"
            app:destination="@id/analysisLight"
            app:launchSingleTop="true" />
    </fragment>
    <fragment
        android:id="@+id/analysisLight"
        android:name="com.example.prog7313_sem1_part2.AnalysisLight"
        android:label="fragment_analysis_light"
        tools:layout="@layout/fragment_analysis_light" />
    <fragment
        android:id="@+id/light_Achievment_Fragment"
        android:name="com.example.prog7313_sem1_part2.Light_Achievment_Fragment"
        android:label="Light_Achievment_Fragment"
        tools:layout="@layout/fragment_light__achievment_"/>
    <fragment
        android:id="@+id/home"
        android:name="com.example.prog7313_sem1_part2.home"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >


        <action
            android:id="@+id/action_home2_to_budgetLight2"
            app:destination="@id/budgetLight" />
        <action
            android:id="@+id/action_home_to_profileLight"
            app:destination="@id/profileLight" />
        <action
            android:id="@+id/action_home_to_transaction_Fragment"
            app:destination="@id/transaction_Fragment" />
        <action
            android:id="@+id/action_home_to_home2Fragment"
            app:destination="@id/home2Fragment" />
        <action
            android:id="@+id/action_home_to_lightWalletFragment"
            app:destination="@id/lightWalletFragment" />
    </fragment>
    <fragment
        android:id="@+id/more_Light_Fragment"
        android:name="com.example.prog7313_sem1_part2.More_Light_Fragment"
        android:label="fragment_more__light_"
        tools:layout="@layout/fragment_more_light" >
        <action
            android:id="@+id/action_more_Light_Fragment_to_categoryFragment"
            app:destination="@id/categoryFragment" />
        <action
            android:id="@+id/action_more_Light_Fragment_to_profileLight"
            app:destination="@id/profileLight" />
        <action
            android:id="@+id/action_more_Light_Fragment_to_budgetLight"
            app:destination="@id/budgetLight" />
        <action
            android:id="@+id/action_more_Light_Fragment_to_logFragment"
            app:destination="@id/logFragment" />
        <action
            android:id="@+id/action_more_Light_Fragment_to_lightWalletFragment"
            app:destination="@id/lightWalletFragment" />
        <action
            android:id="@+id/action_more_Light_Fragment_to_home2Fragment"
            app:destination="@id/home2Fragment" />
        <action
            android:id="@+id/action_more_Light_Fragment_to_AppSecurityFragment"
            app:destination="@id/AppSecurityFragment" />
    </fragment>

    <fragment
        android:id="@+id/editCategoryFragment"
        android:name="com.example.prog7313_sem1_part2.LightEditCategoryFragment"
        android:label="EditCategoryFragment"
        tools:layout="@layout/fragment_edit_category"/>
    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.example.prog7313_sem1_part2.LightCategoryFragment"
        android:label="CategoryFragment"
        tools:layout="@layout/fragment_category">
        <action
            android:id="@+id/action_categoryFragment_to_editCategoryFragment"
            app:destination="@id/editCategoryFragment" />
        <action
            android:id="@+id/action_categoryFragment_to_createCategoryFragment"
            app:destination="@id/createCategoryFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileLight"
        android:name="com.example.prog7313_sem1_part2.ProfileLight"
        android:label="ProfileLight"
        tools:layout="@layout/profile_view"
        >
        <action
            android:id="@+id/action_profileLight_to_logFragment"
            app:destination="@id/logFragment" />
    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.prog7313_sem1_part2.SplashFragment"
        android:label="SplashFragment" >
        <action
            android:id="@+id/action_splashFragment_to_logFragment"
            app:destination="@id/logFragment" />
        <action
            android:id="@+id/action_splashFragment_to_home"
            app:destination="@id/home" />
        <action
            android:id="@+id/action_splashFragment_to_AuthenticationFragment"
            app:destination="@id/AuthenticationFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragmentLight"
        android:name="com.example.prog7313_sem1_part2.RegisterFragmentLight"
        android:label="fragment_register_light"
        tools:layout="@layout/fragment_register_light" />
    <fragment
        android:id="@+id/transaction_Fragment"
        android:name="com.example.prog7313_sem1_part2.Transaction_Fragment"
        android:label="Transaction_Fragment"
        tools:layout="@layout/fragment_transaction_"/>
    <fragment
        android:id="@+id/home2Fragment"
        android:name="com.example.prog7313_sem1_part2.Home2Fragment"
        android:label="Transaction"
        tools:layout="@layout/fragment_home2"/>
    <fragment
        android:id="@+id/lightWalletFragment"
        android:name="com.example.prog7313_sem1_part2.LightWalletFragment"
        android:label="LightWalletFragment"
        tools:layout="@layout/fragment_wallet_light">
        <action
            android:id="@+id/action_lightWalletFragment_to_createWalletFragment"
            app:destination="@id/createWalletFragment" />
        <action
            android:id="@+id/action_lightWalletFragment_to_lightEditWalletFragment"
            app:destination="@id/lightEditWalletFragment" />
    </fragment>
    <fragment
        android:id="@+id/createWalletFragment"
        android:name="com.example.prog7313_sem1_part2.CreateWalletFragment"
        android:label="CreateWalletFragment"
        tools:layout="@layout/add_wallet">

        <action
            android:id="@+id/action_createWalletFragment_to_shareWalletFragment"
            app:destination="@id/ShareWalletFragment"/>

    </fragment>

    <fragment
        android:id="@+id/ShareWalletFragment"
        android:name="com.example.prog7313_sem1_part2.ShareWalletFragment"
        android:label="ShareWalletFragment"
        tools:layout="@layout/share_wallet"/>

    <fragment
        android:id="@+id/createCategoryFragment"
        android:name="com.example.prog7313_sem1_part2.CreateCategoryFragment"
        android:label="CreateCategoryFragment"
        tools:layout="@layout/add_category"/>
    <fragment
        android:id="@+id/lightEditWalletFragment"
        android:name="com.example.prog7313_sem1_part2.LightEditWalletFragment"
        android:label="LightEditWalletFragment"
        tools:layout="@layout/fragment_wallet_edit_light"/>


</navigation>