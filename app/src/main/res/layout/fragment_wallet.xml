                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CASH WALLET"
                                android:textColor="#F2EFE4"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:layout_editor_absoluteX="43dp"
