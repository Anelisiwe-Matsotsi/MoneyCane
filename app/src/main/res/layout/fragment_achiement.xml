<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#001430"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText">

   <View
        android:id="@+id/view2"
        android:layout_width="405dp"
        android:layout_height="143dp"
        android:angle="270"
        android:background="@drawable/custom_rectangle"
        android:backgroundTint="#FFC107"
        android:endColor="#FFC107"
        android:startColor="#A57C01"
        tools:layout_editor_absoluteX="2dp"
        tools:layout_editor_absoluteY="0dp" />

    <TextView
        android:id="@+id/textView17"
        android:layout_width="330dp"
        android:layout_height="67dp"
        android:text="Rewards"
        android:textColor="#F2EFE4"
        android:textDirection="firstStrongLtr"
        android:textSize="48sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="11dp"
        tools:layout_editor_absoluteY="58dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="396dp"
        android:layout_height="495dp"
        android:elevation="12dp"
        app:cardBackgroundColor="#D11E3254"
        app:cardCornerRadius="16dp"
        tools:layout_editor_absoluteX="11dp"
        tools:layout_editor_absoluteY="161dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="381dp"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="330dp"
                android:layout_height="67dp"
                android:text="Your Weekly Challenge"
                android:textColor="#F2EFE4"
                android:textDirection="firstStrongLtr"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="37dp"
                tools:layout_editor_absoluteY="43dp" />



            <ProgressBar
                android:id="@+id/progressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="226dp"
                android:layout_height="188dp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/custom_progress_bar"
                android:scaleX="2f"
                android:scaleY="2f"
                tools:layout_editor_absoluteX="85dp"
                tools:layout_editor_absoluteY="214dp" />

            <TextView
                android:id="@+id/textView20"
                android:layout_width="116dp"
                android:layout_height="63dp"
                android:text="50%"
                android:textColor="#FFC107"
                android:textSize="48sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="144dp"
                tools:layout_editor_absoluteY="98dp" />

            <TextView
                android:id="@+id/textView22"
                android:layout_width="133dp"
                android:layout_height="43dp"
                android:text="Progress"
                android:textColor="#F2EFE4"
                android:textSize="24sp"
                tools:layout_editor_absoluteX="136dp"
                tools:layout_editor_absoluteY="161dp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="165dp"
                android:layout_height="52dp"
                android:text="Great Work!"
                android:textColor="#C8C5C5"
                android:textSize="20sp"
                tools:layout_editor_absoluteX="108dp"
                tools:layout_editor_absoluteY="16dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:weightSum="2"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="731dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/interestsCard"
            android:layout_width="182dp"
            android:layout_height="118dp"
            android:layout_margin="8dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:elevation="16dp"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="#D11E3254"
            app:cardCornerRadius="16dp">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="Canes Earned this Month"
                android:textAllCaps="true"

                android:textColor="#F2EFE4"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="0dp"
                tools:layout_editor_absoluteY="17dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/textView21"
                    android:layout_width="56dp"
                    android:layout_height="45dp"
                    android:text="2"
                    android:textColor="#FFC107"
                    android:textSize="34sp"
                    tools:layout_editor_absoluteX="45dp"
                    tools:layout_editor_absoluteY="56dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/interestsCard"
            android:layout_width="187dp"
            android:layout_height="123dp"
            android:layout_margin="8dp"
            android:clickable="true"
            android:elevation="16dp"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="#D11E3254"
            app:cardCornerRadius="16dp">

            <TextView
                android:id="@+id/textView10"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="Money Saved"
                android:textAllCaps="true"

                android:textColor="#F2EFE4"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="0dp"
                tools:layout_editor_absoluteY="17dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/textView28"
                    android:layout_width="79dp"
                    android:layout_height="49dp"
                    android:text="R500"
                    android:textColor="#FFC107"
                    android:textSize="34sp"
                    tools:layout_editor_absoluteX="22dp"
                    tools:layout_editor_absoluteY="56dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <TextView
        android:id="@+id/textView15"
        android:layout_width="300dp"
        android:layout_height="49dp"
        android:text="Goal Stats"
        android:textColor="#F2EFE4"
        android:textSize="30sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="11dp"
        tools:layout_editor_absoluteY="682dp" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="122dp"
        android:layout_height="88dp"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/green_candy"
        tools:layout_editor_absoluteX="289dp"
        tools:layout_editor_absoluteY="58dp" />

    <TextView
        android:id="@+id/textView30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10"
        android:textColor="#F44336"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="346dp"
        tools:layout_editor_absoluteY="104dp" />


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#008000"
        app:itemTextColor="#008000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:labelVisibilityMode="labeled"/>

</androidx.constraintlayout.widget.ConstraintLayout>