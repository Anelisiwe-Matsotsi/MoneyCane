<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tbWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText">

    <View
        android:id="@+id/view"
        android:layout_width="412dp"
        android:layout_height="165dp"
        android:angle="270"
        android:background="@drawable/custom_rectangle"
        android:backgroundTint="#008000"
        android:endColor="#FFDF01"
        android:startColor="#A57C01"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="-2dp" />

    <ImageButton
        android:id="@+id/profileB3"
        android:layout_width="46dp"
        android:layout_height="54dp"
        android:background="?attr/selectableItemBackground"

        android:scaleType="center"
        android:src="@drawable/ic_light_mode"
        android:tint="#FFC107"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="-6dp" />

    <ImageButton
        android:id="@+id/imgWifi"
        android:layout_width="37dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackground"

        android:scaleType="fitXY"
        android:src="@drawable/ic_notification_bell"
        app:tint="#FFC107"
        tools:layout_editor_absoluteX="358dp"
        tools:layout_editor_absoluteY="16dp" />

    <LinearLayout
        android:layout_width="406dp"
        android:layout_height="402dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:weightSum="2"
        tools:layout_editor_absoluteX="5dp"
        tools:layout_editor_absoluteY="460dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView3"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="12dp"
            app:cardBackgroundColor="#E9F4EA"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHomeTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="318dp"

                >

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Transactions"
                    android:textColor="#162616"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:layout_editor_absoluteX="22dp"
                    tools:layout_editor_absoluteY="4dp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardView2"
                    android:layout_width="374dp"
                    android:layout_height="46dp"
                    android:background="#F6F6F6"
                    tools:layout_editor_absoluteX="-4dp"
                    tools:layout_editor_absoluteY="168dp">

                    <TextView
                        android:id="@+id/textView23"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 March"
                        android:textColor="#162616"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:layout_editor_absoluteX="72dp"
                        tools:layout_editor_absoluteY="29dp" />

                    <ImageView
                        android:id="@+id/imgCat"
                        android:layout_width="68dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_featured_seasonal_and_gifts"
                        app:tint="#FFC107"
                        tools:layout_editor_absoluteX="6dp"
                        tools:layout_editor_absoluteY="11dp" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="72dp"
                        android:text="Gift from mom"
                        android:textColor="#162616"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:layout_editor_absoluteY="10dp" />

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="56dp"
                        android:layout_height="28dp"
                        android:text="+ R200"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        tools:layout_editor_absoluteX="288dp"
                        tools:layout_editor_absoluteY="16dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cv"
                    android:layout_width="372dp"
                    android:layout_height="49dp"
                    android:background="#F6F6F6"
                    tools:layout_editor_absoluteX="3dp"
                    tools:layout_editor_absoluteY="106dp">

                    <TextView
                        android:id="@+id/tvTransactionDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="76dp"
                        android:text="2 March"
                        android:textColor="#162616"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:layout_editor_absoluteY="34dp" />

                    <ImageView
                        android:id="@+id/image_view"
                        android:layout_width="68dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_local_dining"
                        app:tint="#FFC107"
                        tools:layout_editor_absoluteX="6dp"
                        tools:layout_editor_absoluteY="11dp" />

                    <TextView
                        android:id="@+id/tvTranactionName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="76dp"
                        android:text="Coffee"
                        android:textColor="#162616"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:layout_editor_absoluteY="14dp" />

                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="46dp"
                        android:layout_height="25dp"
                        android:text="- R200"
                        android:textColor="#F44336"
                        android:textStyle="bold"
                        tools:layout_editor_absoluteX="289dp"
                        tools:layout_editor_absoluteY="16dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cvCategory"
                    android:layout_width="379dp"
                    android:layout_height="47dp"
                    android:background="#F6F6F6"
                    tools:layout_editor_absoluteX="-9dp"
                    tools:layout_editor_absoluteY="228dp">

                    <TextView
                        android:id="@+id/textView27"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 March"
                        android:textColor="#162616"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:layout_editor_absoluteX="79dp"
                        tools:layout_editor_absoluteY="29dp" />

                    <ImageView
                        android:id="@+id/imgCategory"
                        android:layout_width="68dp"
                        android:layout_height="38dp"
                        android:src="@drawable/shopping_bag_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                        app:tint="#FFC107"
                        tools:layout_editor_absoluteX="12dp"
                        tools:layout_editor_absoluteY="5dp" />

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="76dp"
                        android:text="Dress"
                        android:textColor="#162616"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:layout_editor_absoluteY="5dp" />

                    <TextView
                        android:id="@+id/tvCash"
                        android:layout_width="50dp"
                        android:layout_height="27dp"
                        android:text="- R200"
                        android:textColor="#F44336"
                        android:textStyle="bold"
                        tools:layout_editor_absoluteX="299dp"
                        tools:layout_editor_absoluteY="16dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="69dp"
                    android:layout_height="23dp"
                    android:text="View All"
                    android:textColor="#98008000"
                    tools:layout_editor_absoluteX="288dp"
                    tools:layout_editor_absoluteY="4dp" />

                <com.google.android.material.tabs.TabLayout
                    android:layout_width="366dp"
                    android:layout_height="44dp"
                    android:backgroundTint="#98008000"
                    app:tabIndicatorColor="#FFC107"
                    app:tabSelectedTextColor="#FFC107"
                    app:tabTextColor="#162616"
                    tools:layout_editor_absoluteX="4dp"
                    tools:layout_editor_absoluteY="44dp">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expenses" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Incomes" />
                </com.google.android.material.tabs.TabLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="405dp"
        android:layout_height="229dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:weightSum="2"
        tools:layout_editor_absoluteX="3dp"
        tools:layout_editor_absoluteY="210dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="363dp"
            android:layout_height="208dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="12dp"

            app:cardBackgroundColor="#98008000"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHomeTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"

                android:background="#98008000">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="353dp"
                    android:layout_height="198dp"
                    android:background="#03142E"
                    android:scaleType="fitXY"
                    tools:layout_editor_absoluteX="3dp"
                    tools:layout_editor_absoluteY="3dp"
                    tools:srcCompat="@drawable/screenshot_2026_03_14_203223" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="198dp"
        android:layout_height="72dp"
        android:text="Home"
        android:textColor="#162616"
        android:textSize="48sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="91dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#008000"
        app:itemTextColor="#008000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:labelVisibilityMode="labeled"/>
</androidx.constraintlayout.widget.ConstraintLayout>