<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F6F6">

    <!-- GREEN HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/custom_rectangle"
        android:backgroundTint="#008000">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#001430"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="CREATE Transaction"
            android:textColor="#001430"
            android:textStyle="bold"
            android:textSize="32sp" />
    </RelativeLayout>

    <!-- SCROLLABLE FORM CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- CATEGORY NAME -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Transaction Name"
                android:textColor="#121212"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/tbTransactionName"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="28dp"
                android:backgroundTint="#FFC107"
                android:hint="e.g. Groceries"
                android:inputType="textCapWords"
                android:paddingBottom="12dp"
                android:textColor="#121212"
                android:textColorHint="#9E9E9E"
                android:textSize="18sp" />

            <!-- Transaction AMOUNT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Transaction Amount (R)"
                android:textColor="#121212"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/tbAmount"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginBottom="28dp"
                android:backgroundTint="#FFC107"
                android:hint="e.g. 1500"
                android:inputType="numberDecimal"
                android:paddingBottom="12dp"
                android:textColor="#121212"
                android:textColorHint="#9E9E9E"
                android:textSize="18sp" />

            <!-- Transaction TYPE -->
            <TextView
                android:id="@+id/textViewDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Date of transaction"
                android:textColor="#121212"
                android:textSize="16sp" />

            <DatePicker
                android:id="@+id/datePicker"
                android:layout_width="363dp"
                android:layout_height="164dp"
                android:calendarViewShown="false"
                android:datePickerMode="spinner"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewDate2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Notes"
                android:textColor="#121212"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/tbDescription"
                android:layout_width="match_parent"
                android:layout_height="153dp"
                android:ems="10"
                android:inputType="text"
                android:text="..." />

            <TextView
                android:id="@+id/textViewImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Add Image(optional)"
                android:textColor="#121212"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnChooseImage"
                android:layout_width="351dp"
                android:layout_height="wrap_content"
                android:text="Choose" />

            <TextView
                android:id="@+id/txtUploadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: " />

            <ImageView
                android:id="@+id/imgSelected"
                android:layout_width="372dp"
                android:layout_height="110dp"
                app:srcCompat="@android:drawable/ic_menu_gallery" />

            <Button
                android:id="@+id/btnUploadImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload Image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Expense Type"
                android:textColor="#121212"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/radioGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioExpense"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/select_category_type"
                    android:button="@null"
                    android:buttonTint="#FFC107"
                    android:checked="true"
                    android:gravity="center"
                    android:text="Expense"
                    android:textColor="#121212"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioIncome"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/select_category_type"
                    android:button="@null"
                    android:buttonTint="#FFC107"
                    android:gravity="center"
                    android:text="Income"
                    android:textColor="#121212"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="#008000"
                android:text="ADD Transaction"
                android:textColor="#001430"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="15dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>