<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F2"
    android:orientation="vertical">

<!--    <com.airbnb.lottie.LottieAnimationView-->
<!--        android:id="@+id/animationView"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        app:lottie_url="REPLACE_JSON_URL"-->
<!--        app:lottie_autoPlay="true"-->
<!--        app:lottie_loop="true" />-->

    <!-- GREEN HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"

        android:backgroundTint="#A3C2A3">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#001430" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Add Transaction"
            android:textColor="#001430"
            android:textSize="32sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- SCROLLABLE FORM CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Transaction Name -->
            <TextView
                android:layout_width="92dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Title"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/tbTransactionName"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="28dp"
                android:backgroundTint="#FFC107"
                android:hint="e.g. Groceries"
                android:inputType="textCapWords"
                android:paddingBottom="12dp"
                android:textColor="#121212"
                android:textColorHint="#9E9E9E"
                android:textSize="18sp" />

            <!-- Transaction Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Amount (R)"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/tbAmount"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginBottom="28dp"
                android:backgroundTint="#FFC107"
                android:hint="e.g. 1500"
                android:inputType="numberDecimal"
                android:paddingBottom="12dp"
                android:textColor="#121212"
                android:textColorHint="#9E9E9E"
                android:textSize="18sp" />

            <!-- Date Picker -->
            <TextView
                android:id="@+id/textViewDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Today"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <DatePicker
                android:id="@+id/datePicker"
                android:layout_width="363dp"
                android:layout_height="164dp"
                android:calendarViewShown="false"
                android:datePickerMode="spinner"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Notes -->

            <EditText
                android:id="@+id/tbDescription"
                android:layout_width="match_parent"
                android:layout_height="153dp"
                android:ems="10"
                android:hint="Add Notes"
                android:inputType="text" />

            <!-- Add Image -->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="11dp"
                android:paddingBottom="11dp">

                <TextView
                    android:id="@+id/tvImage"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="36dp"
                    android:text="Add an image (optional)"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnChooseImage"
                    android:layout_width="178dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="#94F9FAF8"
                    android:drawableTint="#009688"
                    android:text="choose image"
                    android:textColor="#050505"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconSize="30dp"
                    app:iconTint="#050505" />
            </RelativeLayout>

            <TextView
                android:id="@+id/txtUploadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: " />

            <ImageView
                android:id="@+id/imgSelected"
                android:layout_width="435dp"
                android:layout_height="110dp"
                app:srcCompat="@android:drawable/ic_menu_gallery" />

            <Button
                android:id="@+id/btnUploadImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#CED5C5"
                android:text="Upload Image" />

            <!-- Expense Type RadioGroup -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Expense Type"
                android:textColor="#121212"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioExpense"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/select_category_type"
                    android:button="@null"
                    android:buttonTint="#FFC107"
                    android:checked="true"
                    android:gravity="center"
                    android:text="Expense"
                    android:textColor="#121212"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioIncome"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/select_category_type"
                    android:button="@null"
                    android:buttonTint="#FFC107"
                    android:gravity="center"
                    android:text="Income"
                    android:textColor="#121212"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Select Category Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_category"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:text="Select Category"
                android:textColor="@color/black"
                android:textSize="15sp"
                app:backgroundTint="#CED5C5"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />

            <!-- Save Button (Material style) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:text="Save "
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="#1B5E20"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />

            <!-- Final ADD Transaction Button -->

        </LinearLayout>
    </ScrollView>
</LinearLayout>