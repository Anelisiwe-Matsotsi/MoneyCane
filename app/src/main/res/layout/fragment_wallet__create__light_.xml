<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tbWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F2"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText">

    <!-- Top green curved header (original: x=0, y=-2, width=412, height=165) -->
    <View
        android:id="@+id/view"
        android:layout_width="0dp"
        android:layout_height="165dp"
        android:background="@drawable/custom_rectangle"
        android:backgroundTint="#A3C2A3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Back button (original: x=-12, y=7) -->
    <ImageButton
        android:id="@+id/profileB2"
        android:layout_width="59dp"
        android:layout_height="49dp"
        android:layout_marginStart="-12dp"
        android:layout_marginTop="7dp"
        android:background="?attr/selectableItemBackground"
        android:src="@drawable/ic_arrow_back"
        app:tint="#FAF6F6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- "Wallet" title (original: x=33, y=49) -->
    <TextView
        android:id="@+id/textView5"
        android:layout_width="243dp"
        android:layout_height="54dp"
        android:layout_marginStart="33dp"
        android:layout_marginTop="49dp"
        android:text="Wallet"
        android:textColor="#001430"
        android:textSize="30dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Wallet balance card (original: x=4, y=112, width=389, height=134) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="134dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="4dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView1"
            android:layout_width="384dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="12dp"
            android:foreground="@drawable/bg_black_border"
            app:cardBackgroundColor="#E9F4EA"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Inner ConstraintLayout – now fully constrained -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="387dp"
                android:layout_height="match_parent"
                android:backgroundTint="#FFC107">

                <!-- "Total Available Balance" – original x=11, y=36 -->
                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="236dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="36dp"
                    android:text="Total Available Balance"
                    android:textColor="#001430"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- "Add Wallet" button – original x=206, y=74 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfileB"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="206dp"
                    android:layout_marginTop="74dp"
                    android:text="Add Wallet"
                    android:textColor="#E4B528"
                    android:textColorLink="#FF9800"
                    app:icon="@android:drawable/ic_menu_add"
                    app:iconPadding="4dp"
                    app:iconSize="30dp"
                    app:iconTint="#FFC107"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Balance amount – original x=56, y=76 -->
                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="56dp"
                    android:layout_marginTop="76dp"
                    android:text="R23453,65"
                    android:textColor="#FFC107"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Wallet icon – original x=277, y=17 → use end margin -->
                <ImageButton
                    android:id="@+id/profileB"
                    android:layout_width="36dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="17dp"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:scaleType="center"
                    android:scaleX="2.0"
                    android:scaleY="2.0"
                    android:src="@drawable/ic_account_balance_wallet"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#D3B65C" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- SearchView (original: x=26, y=273, width=361, height=52) -->
    <SearchView
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="26dp"
        android:layout_marginTop="273dp"
        android:layout_marginEnd="26dp"
        android:background="@drawable/bg_white_rounded"
        android:backgroundTint="#EDE8D7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- "BANK WALLET" card (original: x=22, y=345, width=367, height=118) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="118dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="345dp"
        android:layout_marginEnd="22dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView3"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="12dp"
            app:cardBackgroundColor="#A3C2A3"
            app:cardCornerRadius="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="135dp">

                <!-- Edit button – original x=213, y=2 -->
                <ImageButton
                    android:id="@+id/profileB6"
                    android:layout_width="70dp"
                    android:layout_height="67dp"
                    android:layout_marginStart="213dp"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#001430"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Delete button – original x=249, y=2 -->
                <ImageButton
                    android:id="@+id/profileB4"
                    android:layout_width="70dp"
                    android:layout_height="67dp"
                    android:layout_marginStart="249dp"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#001430"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- BANK WALLET text – original x=44, y=0 -->
                <TextView
                    android:id="@+id/tvWalletType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="0dp"
                    android:text="BANK WALLET"
                    android:textColor="#001430"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Amount – original x=44, y=34 -->
                <TextView
                    android:id="@+id/textView14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="34dp"
                    android:text="-R400,57 ZAR"
                    android:textColor="#001430"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Transactions count – original x=44, y=68 -->
                <TextView
                    android:id="@+id/textView24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="68dp"
                    android:text="5 Transactions"
                    android:textColor="#001430"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Left coloured bar – original x=2, y=2 -->
                <View
                    android:id="@+id/view3"
                    android:layout_width="18dp"
                    android:layout_height="139dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/custom_rectangle"
                    android:backgroundTint="#E4B528"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- "CASH WALLET" main container (original: x=20, y=486, width=374, height=136) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="136dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="486dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cvWallet"
            android:layout_width="333dp"
            android:layout_height="152dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="12dp"
            app:cardBackgroundColor="#A3C2A3"
            app:cardCornerRadius="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="355dp"
                android:layout_height="134dp">

                <!-- Outer edit button – original x=210, y=2 -->
                <ImageButton
                    android:id="@+id/profileB8"
                    android:layout_width="70dp"
                    android:layout_height="67dp"
                    android:layout_marginStart="210dp"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#001430"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Outer delete button – original x=249, y=2 -->
                <ImageButton
                    android:id="@+id/imgDeleteIcon"
                    android:layout_width="70dp"
                    android:layout_height="67dp"
                    android:layout_marginStart="249dp"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#001430"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- CASH WALLET text (outer) – original x=43, y=2 -->
                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="43dp"
                    android:layout_marginTop="2dp"
                    android:text="CASH WALLET"
                    android:textColor="#001430"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Amount (outer) – original x=43, y=34 -->
                <TextView
                    android:id="@+id/textView25"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="43dp"
                    android:layout_marginTop="34dp"
                    android:text="-R400,57 ZAR"
                    android:textColor="#001430"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Transactions (outer) – original x=37, y=69 -->
                <TextView
                    android:id="@+id/textView26"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="37dp"
                    android:layout_marginTop="69dp"
                    android:text="5 Transactions"
                    android:textColor="#001430"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Left coloured bar (outer) – original x=2, y=2 -->
                <View
                    android:id="@+id/view4"
                    android:layout_width="18dp"
                    android:layout_height="139dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/custom_rectangle"
                    android:backgroundTint="#E4B528"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Shared wallet info: name – original x=210, y=94 -->
                <TextView
                    android:id="@+id/textView35"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="210dp"
                    android:layout_marginTop="94dp"
                    android:drawableStart="@drawable/baseline_person_24"
                    android:drawableTint="#FFC107"
                    android:text="Ethan Danials"
                    android:textColor="#001430"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Shared wallet label – original x=37, y=99 -->
                <TextView
                    android:id="@+id/textView36"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="37dp"
                    android:layout_marginTop="99dp"
                    android:text="Shared wallet"
                    android:textColor="#001430"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Nested card for "CASH WALLET" variation (original position preserved) -->
                <LinearLayout
                    android:layout_width="367dp"
                    android:layout_height="118dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="524dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvWallets"
                        android:layout_width="match_parent"
                        android:layout_height="118dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:elevation="12dp"
                        app:cardBackgroundColor="#D11E3254"
                        app:cardCornerRadius="16dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="355dp"
                            android:layout_height="134dp">

                            <ImageButton
                                android:id="@+id/profileB7"
                                android:layout_width="70dp"
                                android:layout_height="67dp"
                                android:layout_marginStart="213dp"
                                android:layout_marginTop="2dp"
                                android:background="?attr/selectableItemBackground"
                                android:src="@android:drawable/ic_menu_edit"
                                app:tint="#EDE8D7"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageButton
                                android:id="@+id/imgDelete"
                                android:layout_width="70dp"
                                android:layout_height="67dp"
                                android:layout_marginStart="249dp"
                                android:layout_marginTop="2dp"
                                android:background="?attr/selectableItemBackground"
                                android:src="@android:drawable/ic_menu_delete"
                                app:tint="#D3B65C"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tvCashWallet"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="43dp"
                                android:layout_marginTop="2dp"
                                android:text="CASH WALLET"
                                android:textColor="#F2EFE4"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tvMoney"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="44dp"
                                android:layout_marginTop="34dp"
                                android:text="-R400,57 ZAR"
                                android:textColor="#F0EFE8"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tvTransactions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="44dp"
                                android:layout_marginTop="68dp"
                                android:text="5 Transactions"
                                android:textColor="#CEC9C0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <View
                                android:id="@+id/vwRectangle"
                                android:layout_width="18dp"
                                android:layout_height="139dp"
                                android:layout_marginStart="2dp"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/custom_rectangle"
                                android:backgroundTint="#E4B528"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Add Shared Wallet button (original: x=104, y=689) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/editProfileB4"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="104dp"
        android:layout_marginTop="689dp"
        android:text="Add  Shared Wallet"
        android:textColor="#E4B528"
        android:textColorLink="#FF9800"
        app:icon="@android:drawable/ic_menu_add"
        app:iconPadding="4dp"
        app:iconSize="30dp"
        app:iconTint="#FFC107"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton3"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#EDE8D7"
        app:fabCustomSize="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="30dp"
        app:rippleColor="#EDE8D7" />

    <!-- Floating action button (original: x=315, y=731) -->

    <!-- Bottom navigation (already constrained) -->


</androidx.constraintlayout.widget.ConstraintLayout>