<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9F2">

    <!-- GREEN HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/custom_rectangle"
        android:backgroundTint="#A3C2A3">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#001430"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="CREATE GOAL"
            android:textColor="#001430"
            android:textStyle="bold"
            android:textSize="32sp" />
    </RelativeLayout>

    <!-- SCROLLABLE FORM CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- CATEGORY NAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goal Name"
                android:textColor="#121212"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etGoalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Birthday"
                android:textColor="#121212"
                android:textColorHint="#9E9E9E"
                android:backgroundTint="#FFC107"
                android:textSize="18sp"
                android:paddingBottom="12dp"
                android:inputType="textCapWords"
                android:layout_marginBottom="28dp" />

            <!-- Target amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Amount (R)"
                android:textColor="#121212"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etTargetAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 1500"
                android:textColor="#121212"
                android:textColorHint="#9E9E9E"
                android:backgroundTint="#FFC107"
                android:textSize="18sp"
                android:paddingBottom="12dp"
                android:inputType="numberDecimal"
                android:layout_marginBottom="28dp" />

            <!-- CATEGORY TYPE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Goal Type"
                android:textColor="#121212"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/rgGoalType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="40dp">

                <RadioButton
                    android:id="@+id/radioExpense"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Expense Goal"
                    android:textColor="#121212"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:checked="true"
                    android:gravity="center"
                    android:button="@null"
                    android:background="@drawable/select_category_type"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="#FFC107"/>

                <RadioButton
                    android:id="@+id/radioIncome"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Savings Goal"
                    android:textColor="#121212"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:button="@null"
                    android:background="@drawable/select_category_type"
                    android:layout_marginStart="8dp"
                    android:buttonTint="#FFC107"/>
            </RadioGroup>

            <!-- Date Picker -->
            <TextView
                android:id="@+id/textViewDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="From:"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <DatePicker
                android:id="@+id/startDate"
                android:layout_width="363dp"
                android:layout_height="164dp"
                android:calendarViewShown="false"
                android:datePickerMode="spinner"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewDateEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="To:"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <DatePicker
                android:id="@+id/endDate"
                android:layout_width="363dp"
                android:layout_height="164dp"
                android:calendarViewShown="false"
                android:datePickerMode="spinner"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />




            <!-- ADD Goal BUTTON -->
            <Button
                android:id="@+id/btnSaveGoal"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Save Goal"
                android:textColor="#001430"
                android:textStyle="bold"
                android:textSize="16sp"
                android:backgroundTint="#A3C2A3"
                app:cornerRadius="15dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>