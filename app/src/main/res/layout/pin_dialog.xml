    <!-- PROMPT -->
    <TextView
        android:id="@+id/tvPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter 4 digit Code"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- PIN DISPLAY -->
    <TextView
        android:id="@+id/tvPinArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="- - - -"
        android:textSize="28sp"
        android:textColor="#888"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPrompt"/>

    <!-- NUMPAD -->
    <GridLayout
        android:id="@+id/numPad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvPinArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/num1"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="1"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>

        <Button
            android:id="@+id/num2"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="2"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>

        <Button
            android:id="@+id/num3"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="3"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>

        <Button
            android:id="@+id/num4"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="4"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>
        <Button
            android:id="@+id/num5"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="5"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>
        <Button
            android:id="@+id/num6"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="6"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>


        <Button
            android:id="@+id/num7"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="7"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>
        <Button
            android:id="@+id/num8"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="8"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>
        <Button
            android:id="@+id/num9"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="9"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>


        <Space
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"/>

        <Button
            android:id="@+id/num0"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="0"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFC107"
            android:layout_margin="6dp"/>

        <Button android:id="@+id/clearCode"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:text="Clear"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:backgroundTint="#A3C2A3"
            android:layout_margin="6dp"/>

    </GridLayout>

    <Button
        android:id="@+id/confirmButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Done"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#A3C2A3"
        android:layout_marginTop="20dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/numPad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

