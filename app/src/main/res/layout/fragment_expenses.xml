<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6">


    <LinearLayout
        android:id="@+id/filterHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"

        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/tab_selected_shape"
            android:backgroundTint="#E8F5E9"
            android:clickable="true"
            android:focusable="true"

            android:padding="12dp"
            android:text="All"
            android:textColor="#008000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/tab_selected_shape"
            android:backgroundTint="#E8F5E9"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"

            android:text="Today"
            android:textColor="#008000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSelectMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/tab_selected_shape"
            android:backgroundTint="#E8F5E9"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"

            android:text="Monthly"
            android:textColor="#008000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTransactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:nestedScrollingEnabled="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterHeader" />


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/iconAddTransaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:contentDescription="Add Transaction"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#A3C2A3"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>