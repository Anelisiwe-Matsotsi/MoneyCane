<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="?android:attr/colorBackground"
    tools:context=".home">
    <!--Main Content-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_main_welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Top green curved header -->
            <FrameLayout
                android:id="@+id/v_header_green"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:background="@drawable/custom_rectangle"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" Good Evening"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="20sp"
                            android:textStyle="bold" />


                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/themeBtn"
                        android:layout_width="66dp"
                        android:layout_height="match_parent"

                        android:backgroundTint="#00FFFFFF"
                        android:padding="10dp"
                        android:src="@drawable/ic_dark_mode"
                        app:tint="#FFC107" />
                </LinearLayout>


                <View
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginStart="-120dp"
                    android:layout_marginTop="-80dp"
                    android:alpha="0.03"
                    android:background="@drawable/bg_translucent_circle" />

                <View
                    android:layout_width="300dp"
                    android:layout_height="140dp"

                    android:layout_marginStart="-70dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_wave"
                    android:rotation="-18" />

                <View
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="25dp"
                    android:layout_marginEnd="50dp"
                    android:alpha="0.02"
                    android:background="@drawable/bg_translucent_circle" />

            </FrameLayout>


            <!-- Dark mode button (top left) -->

            <!-- Notification bell (top right) -->

            <!-- "Home" title -->

            <!-- Wallet balance card -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_wallet_balance"
                android:layout_width="370dp"
                android:layout_height="149dp"
                android:elevation="20dp"
                android:foreground="@drawable/bg_soft_border"
                android:translationY="100dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"

                app:layout_constraintBottom_toBottomOf="@+id/v_header_green"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_wallet_balance_label"
                        android:layout_width="146dp"
                        android:layout_height="19dp"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="55dp"
                        android:text="Your wallet balance"
                        android:textColor="#0E3704"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_wallet"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="206dp"
                        android:layout_marginTop="74dp"
                        android:layout_marginEnd="22dp"
                        android:text="Add Wallet"
                        android:textColor="#98008000"
                        android:textColorLink="#FF9800"
                        app:icon="@android:drawable/ic_menu_add"
                        app:iconPadding="4dp"
                        app:iconSize="30dp"
                        app:iconTint="#FFC107"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvWalletBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="76dp"
                        android:layout_marginTop="81dp"
                        android:textColor="#008000"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_welcome_name"
                        android:layout_width="262dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="-"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.336"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:id="@+id/ib_arrow_forward"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="101dp"
                        android:background="?attr/selectableItemBackground"
                        android:src="@drawable/ic_arrow_foward"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#D3B65C" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- NEW: ADD TRANSACTION Button (green, outlined, with plus icon) -->

            <!-- Monthly Budget card -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_monthly_budget"
                android:layout_width="374dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:elevation="12dp"
                android:translationY="-60dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="24dp"
                app:layout_constraintBottom_toTopOf="@+id/cv_weekly_goal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cv_wallet_balance">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/custome_rectangle"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_monthly_budget_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Monthly Spending"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/btn_add_budget_container"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_monthly_budget_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="R 0,00 left of R 0,00"
                            android:textColor="#F4FFF4"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_monthly_budget_title" />

                        <FrameLayout
                            android:id="@+id/btn_add_budget_container"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageButton
                                android:id="@+id/btn_add_budget"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@android:drawable/ic_menu_add"
                                app:tint="#FFC107" />
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ProgressBar
                            android:id="@+id/pb_monthly_budget"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="40"
                            android:progressBackgroundTint="#E5E7EB"
                            android:progressTint="#FFC107" />

                        <TextView
                            android:id="@+id/tv_monthly_budget_of"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="of R 0,00"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/graph_preview_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cv_monthly_budget" />
            <!-- Weekly Goal card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_weekly_goal"
                android:layout_width="375dp"
                android:layout_height="106dp"

                android:layout_marginBottom="195dp"
                android:clickable="true"
                android:elevation="16dp"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/graph_preview_container">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_weekly_goal_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weekly Goal Target"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_weekly_goal_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R 0,00 left"
                        android:textColor="#008000"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ProgressBar
                        android:id="@+id/pb_weekly_goal"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progress="60"
                        android:progressBackgroundTint="#E5E7EB"
                        android:progressTint="#FFC107"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_weekly_goal_title" />

                    <TextView
                        android:id="@+id/tv_weekly_goal_of"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Min: R 0 | Max: R 0"
                        android:textColor="#6B7280"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/pb_weekly_goal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_set_goal"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Set Target"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp"
                        app:icon="@android:drawable/ic_menu_add"
                        app:iconSize="16dp"
                        app:iconTint="#FFC107"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/pb_weekly_goal"
                        app:layout_constraintVertical_bias="1.0" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_transaction"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="250dp"
                android:layout_height="63dp"
                android:layout_marginTop="20dp"
                android:text="ADD TRANSACTION"
                android:textAllCaps="true"
                android:textColor="#008000"
                android:textSize="16sp"
                app:icon="@android:drawable/ic_menu_add"
                app:iconPadding="8dp"
                app:iconSize="24dp"
                app:iconTint="#008000"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cv_weekly_goal"
                app:strokeColor="#008000"
                app:strokeWidth="1dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>


    <!-- Bottom Sheet -->

    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_background"
        android:elevation="30dp"
        android:orientation="vertical"
        app:behavior_fitToContents="true"
        app:behavior_peekHeight="110dp"


        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Drag handle for accessibility -->
        <View

            android:layout_width="60dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Bottom sheet contents. -->
        <!--Header-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transactions"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseSheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </RelativeLayout>
        <!--View Transactions fragment-->
        <FrameLayout
            android:id="@+id/transaction_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>


