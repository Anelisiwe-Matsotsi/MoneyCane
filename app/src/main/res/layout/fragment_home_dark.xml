                        tools:layout_editor_absoluteX="12dp"
                        tools:layout_editor_absoluteY="5dp" />

                    <TextView
                        android:id="@+id/tvTransactionName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="80dp"
