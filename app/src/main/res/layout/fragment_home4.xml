<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F6F6"
    tools:context=".home">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_main_welcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top green curved header -->
        <View
            android:id="@+id/v_header_green"
            android:layout_width="0dp"
            android:layout_height="165dp"
            android:background="@drawable/custom_rectangle"
            android:backgroundTint="#A3C2A3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Dark mode button (top left) -->
        <ImageButton
            android:id="@+id/ib_dark_mode"
            android:layout_width="46dp"
            android:layout_height="54dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="-6dp"
            android:background="?attr/selectableItemBackground"
            android:scaleType="center"
            android:src="@drawable/ic_dark_mode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFC107" />

        <!-- Notification bell (top right) -->
        <ImageButton
            android:id="@+id/ib_notification"
            android:layout_width="37dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackground"
            android:scaleType="fitXY"
            android:src="@drawable/ic_notification_bell"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFC107" />

        <!-- "Home" title -->
        <TextView
            android:id="@+id/tv_home_title"
            android:layout_width="94dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="48dp"
            android:text="Home"
            android:textColor="#001430"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Wallet balance card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_wallet_balance"
            android:layout_width="0dp"
            android:layout_height="134dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="12dp"
            android:foreground="@drawable/bg_black_border"
            app:cardBackgroundColor="#E9F4EA"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_header_green">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tv_wallet_balance_label"
                    android:layout_width="146dp"
                    android:layout_height="19dp"
                    android:text="Your wallet balance"
                    android:textColor="#F2EFE4"
                    android:textSize="14sp"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="55dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_wallet"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Wallet"
                    android:textColor="#98008000"
                    android:textColorLink="#FF9800"
                    app:icon="@android:drawable/ic_menu_add"
                    app:iconPadding="4dp"
                    app:iconSize="30dp"
                    app:iconTint="#FFC107"
                    android:layout_marginStart="206dp"
                    android:layout_marginTop="74dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_wallet_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R23453,65"
                    android:textColor="#008000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="76dp"
                    android:layout_marginTop="81dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_welcome_name"
                    android:layout_width="144dp"
                    android:layout_height="28dp"
                    android:text="Hi Natty"
                    android:textColor="#162616"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/ib_arrow_forward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_arrow_foward"
                    app:tint="#D3B65C"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- NEW: ADD TRANSACTION Button (green, outlined, with plus icon) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_transaction"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="ADD TRANSACTION"
            android:textColor="#008000"
            android:textSize="16sp"
            android:textAllCaps="true"
            app:icon="@android:drawable/ic_menu_add"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconTint="#008000"
            app:strokeColor="#008000"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cv_wallet_balance" />

        <!-- Monthly Budget card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_monthly_budget"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:elevation="16dp"
            android:focusable="true"
            app:cardBackgroundColor="#A3C2A3"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_add_transaction">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_budget"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="173dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="55dp"
                    android:layout_marginTop="43dp"
                    android:text="Add Budget"
                    android:textColor="#162616"
                    android:textColorLink="#FF9800"
                    app:icon="@android:drawable/ic_menu_add"
                    app:iconPadding="4dp"
                    app:iconSize="30dp"
                    app:iconTint="#FFC107"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ProgressBar
                    android:id="@+id/pb_monthly_budget"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="228dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="27dp"
                    android:max="100"
                    android:progress="40"
                    android:progressBackgroundTint="#F8EEEE"
                    android:progressTint="#FFC107"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_monthly_budget_title"
                    android:layout_width="154dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="42dp"
                    android:layout_marginTop="5dp"
                    android:text="Monthly Budget"
                    android:textColor="#162616"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_monthly_budget_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="258dp"
                    android:layout_marginTop="30dp"
                    android:text="R 6000,50 left"
                    android:textColor="#162616"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_monthly_budget_of"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="273dp"
                    android:layout_marginTop="54dp"
                    android:hint="of R 7000"
                    android:textColor="#F2EFE4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Weekly Goal card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_weekly_goal"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:elevation="16dp"
            android:focusable="true"
            app:cardBackgroundColor="#A3C2A3"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cv_monthly_budget">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_goal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="173dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="55dp"
                    android:layout_marginTop="43dp"
                    android:text="Set Goal"
                    android:textColor="#162616"
                    android:textColorLink="#FF9800"
                    app:icon="@android:drawable/ic_menu_add"
                    app:iconPadding="4dp"
                    app:iconSize="30dp"
                    app:iconTint="#FFC107"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ProgressBar
                    android:id="@+id/pb_weekly_goal"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="228dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="27dp"
                    android:max="100"
                    android:progress="60"
                    android:progressBackgroundTint="#F8EEEE"
                    android:progressTint="#FFC107"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_weekly_goal_title"
                    android:layout_width="154dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="42dp"
                    android:layout_marginTop="5dp"
                    android:text="Weekly Goal"
                    android:textColor="#162616"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_weekly_goal_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="258dp"
                    android:layout_marginTop="30dp"
                    android:text="R 6000,50 left"
                    android:textColor="#162616"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_weekly_goal_of"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="273dp"
                    android:layout_marginTop="54dp"
                    android:hint="of R 7000"
                    android:textColor="#F2EFE4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Image banner (promo) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_promo_banner"
            android:layout_width="0dp"
            android:layout_height="208dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="12dp"
            app:cardBackgroundColor="#A3C2A3"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cv_weekly_goal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="202dp"
                android:background="#A3C2A3">

                <ImageView
                    android:id="@+id/iv_promo_image"
                    android:layout_width="347dp"
                    android:layout_height="196dp"
                    android:layout_marginTop="16dp"
                    android:background="#03142E"
                    android:scaleType="fitXY"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.615"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:srcCompat="@drawable/screenshot_2026_03_14_203223" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recent Transactions card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_recent_transactions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="12dp"
            app:cardBackgroundColor="#E9F4EA"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cv_promo_banner">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tv_recent_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="4dp"
                    android:text="Recent Transactions"
                    android:textColor="#162616"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/btnViewTransactions"
                    android:layout_width="69dp"
                    android:layout_height="23dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp"
                    android:text="View All"
                    android:textColor="#98008000"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="1dp"
                    android:backgroundTint="#A3C2A3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_recent_title"
                    app:tabIndicatorColor="#FFC107"
                    app:tabSelectedTextColor="#FFC107"
                    app:tabTextColor="#162616">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expenses" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Incomes" />

                </com.google.android.material.tabs.TabLayout>

                <!-- Transaction item 1: Gift from mom -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_transaction_gift"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="2dp"
                    android:background="#F6F6F6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tab_layout">

                    <ImageView
                        android:id="@+id/iv_transaction_icon_gift"
                        android:layout_width="68dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_featured_seasonal_and_gifts"
                        app:tint="#121212"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_transaction_title_gift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="72dp"
                        android:text="Gift from mom"
                        android:textColor="#162616"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_transaction_date_gift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 March"
                        android:textColor="#162616"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@+id/tv_transaction_title_gift"
                        app:layout_constraintTop_toBottomOf="@+id/tv_transaction_title_gift" />

                    <TextView
                        android:id="@+id/tv_transaction_amount_gift"
                        android:layout_width="56dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="16dp"
                        android:text="+ R200"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Transaction item 2: Coffee -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_transaction_coffee"
                    android:layout_width="0dp"
                    android:layout_height="49dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="#F6F6F6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_transaction_gift">

                    <ImageView
                        android:id="@+id/iv_transaction_icon_coffee"
                        android:layout_width="68dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/whatsapp_image_2026_03_17_at_17_25_51__1_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_transaction_title_coffee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="76dp"
                        android:text="Coffee"
                        android:textColor="#162616"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_transaction_date_coffee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 March"
                        android:textColor="#162616"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@+id/tv_transaction_title_coffee"
                        app:layout_constraintTop_toBottomOf="@+id/tv_transaction_title_coffee" />

                    <TextView
                        android:id="@+id/tv_transaction_amount_coffee"
                        android:layout_width="46dp"
                        android:layout_height="25dp"
                        android:layout_marginEnd="16dp"
                        android:text="- R200"
                        android:textColor="#F44336"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Transaction item 3: Dress -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_transaction_dress"
                    android:layout_width="0dp"
                    android:layout_height="47dp"
                    android:layout_marginStart="-4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="-4dp"
                    android:background="#F6F6F6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_transaction_coffee">

                    <ImageView
                        android:id="@+id/iv_transaction_icon_dress"
                        android:layout_width="68dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/screenshot_2026_03_14_203223"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_transaction_title_dress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="76dp"
                        android:text="Dress"
                        android:textColor="#162616"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_transaction_date_dress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 March"
                        android:textColor="#162616"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@+id/tv_transaction_title_dress"
                        app:layout_constraintTop_toBottomOf="@+id/tv_transaction_title_dress" />

                    <TextView
                        android:id="@+id/tv_transaction_amount_dress"
                        android:layout_width="50dp"
                        android:layout_height="27dp"
                        android:layout_marginEnd="16dp"
                        android:text="- R200"
                        android:textColor="#F44336"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>